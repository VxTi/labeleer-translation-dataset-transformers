exports[`android strings serialization > should serialize an android strings dataset with pluralization 1`] = `
{
  "content": "<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="regular">a regular string</string>
  <plurals name="strict">
    <item quantity="one">one strict</item>
  </plurals>
</resources>
",
  "filePath": "values-en/strings.xml",
  "locale": "en_US",
}
`;
