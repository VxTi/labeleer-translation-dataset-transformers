{
  "name": "@labeleer/translation-dataset-transformers",
  "version": "2.2.5",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "private": false,
  "sideEffects": false,
  "type": "module",
  "description": "Utility parser methods used by all Labeleer tools",
  "author": "Luca Warmenhoven",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:imports": "tsx ./bin/check-exports.ts",
    "fix:imports": "tsx ./bin/check-exports.ts --fix",
    "build": "tsc --p tsconfig.release.json && tsc-alias -p tsconfig.release.json",
    "prepublishOnly": "pnpm run clean; pnpm run lint && pnpm run check:imports && pnpm run test && pnpm run build && node bin/test-build-import.js",
    "test": "vitest run -u",
    "test:ci": "vitest run",
    "lint": "eslint --fix \"./src/**/*.ts\" --cache --max-warnings 0",
    "sanity": "npm run lint && npm run test && npm run check:types && npm run clean",
    "clean": "rm -rf ./dist"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/gettext-parser": "^9.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.47.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.4",
    "chalk": "^6.0.0"
  },
  "dependencies": {
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2",
    "gettext-parser": "^9.1.1",
    "lodash-es": "^4.18.1",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@12.0.0"
}
